{
  "folders": [
    {
      "name": "Application",
      "path": ".."
    },
    {
      "name": "Task 09",
      "path": "../tasks/09-retry-policy"
    },
    {
      "name": "Session 09.1",
      "path": "../sessions/09.1"
    },
    {
      "name": "Session 09.2",
      "path": "../sessions/09.2"
    },
    {
      "name": "Session 09.3",
      "path": "../sessions/09.3"
    }
  ],
  "settings": {
    "files.exclude": {
      "tasks": true,
      "sessions": true,
      "workspaces": true
    },
    "terminal.integrated.cwd": "${workspaceFolder:Application}",
    "terminal.integrated.env.osx": {
      "HD_TASK": "9"
    },
    "terminal.integrated.env.linux": {
      "HD_TASK": "9"
    },
    "terminal.integrated.env.windows": {
      "HD_TASK": "9"
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Task 09: Select session",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "start",
          "9",
          "--session",
          "${input:sessionId}"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}"
        },
        "problemMatcher": []
      },
      {
        "label": "Task 09: Start application",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "serve"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Run tests",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Capture task probe",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "probe"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Capture current database",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "database"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Capture source diff",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "diff"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Capture report benchmark",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "benchmark"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Capture worker status",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "worker-status"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Tick worker",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "worker-tick"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Task 09: Requeue unsent job",
        "type": "process",
        "command": "${workspaceFolder:Application}/lab",
        "args": [
          "record",
          "worker-requeue",
          "--job",
          "${input:jobId}"
        ],
        "options": {
          "cwd": "${workspaceFolder:Application}",
          "env": {
            "HD_TASK": "9"
          }
        },
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "jobId",
        "type": "promptString",
        "description": "Job ID from the notification queue"
      },
      {
        "id": "sessionId",
        "type": "pickString",
        "description": "Choose the task session",
        "options": [
          "09.1",
          "09.2",
          "09.3"
        ]
      }
    ]
  }
}
