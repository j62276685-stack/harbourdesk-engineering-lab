{
  "folders": [
    {
      "name": "HarbourDesk",
      "path": "../.."
    }
  ],
  "settings": {
    "files.exclude": {
      "tds": true
    },
    "terminal.integrated.cwd": "${workspaceFolder:HarbourDesk}",
    "terminal.integrated.env.osx": {
      "HD_TASK": "5"
    },
    "terminal.integrated.env.linux": {
      "HD_TASK": "5"
    },
    "terminal.integrated.env.windows": {
      "HD_TASK": "5"
    },
    "chat.disableAIFeatures": true,
    "search.exclude": {
      "**/tds": true
    },
    "window.title": "${activeEditorShort}${separator}HarbourDesk${separator}${appName}"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start application",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "serve"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Run tests",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "test"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Run diagnostics",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "probe"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Capture current database",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "database"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Capture source diff",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "diff"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Capture report benchmark",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "benchmark"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Capture worker status",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "worker-status"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Tick worker",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "worker-tick"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": [],
        "presentation": {
          "echo": false,
          "reveal": "always"
        }
      },
      {
        "label": "Requeue unsent job",
        "type": "process",
        "command": "${workspaceFolder:HarbourDesk}/tds/lab",
        "args": [
          "record",
          "worker-requeue",
          "--job",
          "${input:jobId}"
        ],
        "options": {
          "cwd": "${workspaceFolder:HarbourDesk}",
          "env": {
            "HD_TASK": "5"
          }
        },
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "jobId",
        "type": "promptString",
        "description": "Job ID from the notification queue"
      }
    ]
  }
}
