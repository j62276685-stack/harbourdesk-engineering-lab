#!/bin/sh
set -eu
LAB_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${LAB_PYTHON:-}" ]; then
  exec "$LAB_PYTHON" "$LAB_ROOT/lab.py" "$@"
fi
if command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
  exec python3 "$LAB_ROOT/lab.py" "$@"
fi
LAB_BUNDLED_PYTHON="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3"
if [ -x "$LAB_BUNDLED_PYTHON" ]; then
  exec "$LAB_BUNDLED_PYTHON" "$LAB_ROOT/lab.py" "$@"
fi
echo 'Python 3.9+ is required. Set LAB_PYTHON to an installed Python executable.' >&2
exit 1
